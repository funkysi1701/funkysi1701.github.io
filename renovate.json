{
  "packageRules": [
    {
      "description": "Frozen HBS v0.65.1 fork: production Hugo does not run theme webpack.",
      "matchFileNames": [
        "themes/hugo-theme-bootstrap/package.json"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.env$/"
      ],
      "matchStrings": [
        "HUGO_VERSION=(?<currentValue>.+)"
      ],
      "currentValueTemplate": "{{currentValue}}",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "Florin-Lungu/docker-hugo",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "depNameTemplate": "hugo"
    }
  ],
  "enabledManagers": [
    "custom.regex",
    "npm",
    "github-actions"
  ]
}
